schemaVersion: "1"
name: am
agent: den-claude
kits:
  - /denhome/gen/am/den-claude
  - /src/api/tpl/kits/tk
  - /proj/kits/k
  - /denhome/gen/am/network
workspace: /proj
additionalWorkspaces:
  - path: /src/api
  - path: /proj/den.yaml
    target: /proj/den.yaml
    readOnly: true
  - path: /src/api/tpl/den-template.yaml
    target: /src/api/tpl/den-template.yaml
    readOnly: true
  - path: /src/api/tpl/kits/tk
    target: /src/api/tpl/kits/tk
    readOnly: true
  - path: /proj/kits/k
    target: /proj/kits/k
    readOnly: true
  - path: /src/api/sbx/extra.yaml
    target: /src/api/sbx/extra.yaml
    readOnly: true
  - path: /src/api/tpl/lib.sh
    target: /src/api/tpl/lib.sh
    readOnly: true
  - path: /src/api/tpl/10-node.sh
    target: /src/api/tpl/10-node.sh
    readOnly: true
env:
  DEN_REPOS: /home/agent/.den/repos.json
sandboxOptions:
  template: legacy:v2
